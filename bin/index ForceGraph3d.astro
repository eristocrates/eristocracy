---
import ReactForce3D from "../components/react/ForceGraph3D";
// import ReteEditorSimple from "../components/react/ReteEditorSimple";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Ontology Visualization & Configuration</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #1a1a1a;
        color: white;
        overflow: hidden;
        position: relative;
      }
      .layout {
        position: relative;
        height: 100vh;
        width: 100vw;
      }
      .graph-panel {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #000;
        z-index: 1;
      }
      .config-panel {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 400px;
        height: 500px;
        background: rgba(42, 42, 42, 0.95);
        border: 1px solid #444;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        z-index: 10;
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
      }
      .panel-header {
        padding: 15px 20px;
        background: rgba(51, 51, 51, 0.9);
        border-bottom: 1px solid #444;
        font-weight: bold;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 8px 8px 0 0;
      }
      .rete-container {
        flex: 1;
        overflow: hidden;
        border-radius: 0 0 8px 8px;
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <!-- Main 3D Graph Visualization (full screen background) -->
      <div class="graph-panel">
        <ReactForce3D client:only="react" />
      </div>

      <!-- Floating Configuration Panel (overlay) 
      <div class="config-panel">
        <div class="panel-header">Visual Configuration</div>
        <div class="rete-container">
          <ReteEditorSimple client:only="react" />
        </div>
      </div>
    </div>-->
    </div>
  </body>
</html>
