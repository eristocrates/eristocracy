---
// Astro component for client-side Rete editor
---

<div id="rete-status" class="status">Status: Initializing...</div>
<div id="rete-container" class="editor-container"></div>

<style>
  .status {
    background: #333;
    color: white;
    padding: 10px;
    border-radius: 4px;
    margin-bottom: 10px;
    font-family: monospace;
    font-size: 14px;
  }

  .editor-container {
    width: 100%;
    height: 500px;
    background: #f5f5f5;
    border: 2px solid #666;
    border-radius: 8px;
    position: relative;
  }
</style>

<script>
  // This script runs on the client side in Astro
  async function initReteEditor() {
    const statusEl = document.getElementById("rete-status");
    const containerEl = document.getElementById("rete-container");

    const updateStatus = (msg) => {
      if (statusEl) {
        statusEl.textContent = `Status: ${msg}`;
        console.log(msg);
      }
    };

    try {
      updateStatus("Loading Rete modules...");

      // Use local packages instead of CDN
      const { NodeEditor, ClassicPreset } = await import("rete");
      const { AreaPlugin, AreaExtensions } = await import("rete-area-plugin");
      const { ConnectionPlugin, Presets: ConnectionPresets } = await import(
        "rete-connection-plugin"
      );

      updateStatus("Creating editor...");

      if (!containerEl) throw new Error("Container not found");

      // Clear container
      containerEl.innerHTML = "";

      // Create editor - the Scope issue should be resolved with proper local packages
      const editor = new NodeEditor();
      const area = new AreaPlugin(containerEl);
      const connection = new ConnectionPlugin();

      updateStatus("Setting up plugins...");

      // Setup connection presets
      connection.addPreset(ConnectionPresets.classic.setup());

      // Use plugins in correct order
      editor.use(area);
      area.use(connection);

      updateStatus("Creating nodes...");

      // Create socket first for type consistency
      const socket = new ClassicPreset.Socket("socket");

      // Create Hello node
      const helloNode = new ClassicPreset.Node("Hello World");
      helloNode.addControl(
        "text",
        new ClassicPreset.InputControl("text", { initial: "Hello" })
      );
      helloNode.addOutput("value", new ClassicPreset.Output(socket, "Text"));
      await editor.addNode(helloNode);

      // Create Display node
      const displayNode = new ClassicPreset.Node("Display");
      displayNode.addInput("input", new ClassicPreset.Input(socket, "Input"));
      displayNode.addControl(
        "output",
        new ClassicPreset.InputControl("text", {
          initial: "Output will appear here",
          readonly: true,
        })
      );
      await editor.addNode(displayNode);

      updateStatus("Positioning nodes...");

      // Position nodes
      await area.translate(helloNode.id, { x: 50, y: 100 });
      await area.translate(displayNode.id, { x: 400, y: 100 });

      updateStatus("Connecting nodes...");

      // Connect the nodes
      await editor.addConnection(
        new ClassicPreset.Connection(helloNode, "value", displayNode, "input")
      );

      updateStatus("Adding interactivity...");

      // Make nodes selectable
      AreaExtensions.selectableNodes(area, AreaExtensions.selector(), {
        accumulating: AreaExtensions.accumulateOnCtrl(),
      });

      // Add proper node ordering
      AreaExtensions.simpleNodesOrder(area);

      updateStatus("Fitting viewport...");

      // Fit view to show all nodes
      setTimeout(() => {
        try {
          AreaExtensions.zoomAt(area, editor.getNodes());
          updateStatus("Ready! 🎉");
        } catch (e) {
          console.warn("Zoom fit failed:", e);
          updateStatus("Ready! (zoom failed)");
        }
      }, 1000);

      console.log("Rete editor initialized successfully!");
    } catch (error) {
      console.error("Failed to initialize Rete editor:", error);
      const errorMessage =
        error instanceof Error ? error.message : String(error);
      updateStatus(`Error: ${errorMessage}`);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReteEditor);
  } else {
    initReteEditor();
  }
</script>
