          </li>
          <!-- Performance Controls -->
          <li
            style="border-top: 1px solid #ccc; margin-top: 10px; padding-top: 10px;"
          >
            <strong>Performance Settings:</strong>
          </li>
          <li>
            <strong>Max Node Count:</strong>
            <input
              id="val-maxNodeCount"
              type="number"
              step="10"
              min="10"
              max="1000"
            />
