          </li>
          <li>
            <strong>Performance Mode:</strong>
            <input id="val-performanceMode" type="checkbox" disabled />
            <small>(Auto-enabled for large graphs)</small>
          </li>
          <li>
            <strong>FPS Throttling:</strong>
            <input id="val-useFPSThrottling" type="checkbox" />
          </li>
        </ul>
      </div>
    </div>

    <!-- Graph Control Buttons -->
    <div id="graph-controls">
      <button
        id="freeze-btn"
        type="button"
        title="Freeze/Stop simulation (Spacebar)">⏸️ Freeze</button
      >
      <button
        id="unfreeze-btn"
        type="button"
        title="Resume simulation (Spacebar)"
        style="display: none;">▶️ Resume</button
      >
      <button id="fit-btn" type="button" title="Fit graph to screen (F)"
        >🔍 Fit</button
      >
      <button
        id="pin-toggle-btn"
        type="button"
        title="Toggle node pinning on drag (P)">📌 Pin Mode</button
      >
      <button
        id="highlight-toggle-btn"
        type="button"
        title="Toggle hover highlighting (H)"
        class="active">💡 Highlight</button
      >
    </div>

    <!-- Zoom Control Buttons -->
    <div id="zoom-controls">
      <button id="zoom-in-btn" type="button" title="Zoom In (+)">➕</button>
      <button id="zoom-out-btn" type="button" title="Zoom Out (-)">➖</button>
    </div>

    <!-- Node Tooltip -->
    <div id="node-tooltip"></div>
  </body>
</html>
