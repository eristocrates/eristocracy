          </li>
          <li>
            <strong>Show TBox (Classes):</strong>
            <input id="val-showClasses" type="checkbox" />
          </li>
          <li>
            <strong>Show ABox (Instances):</strong>
            <input id="val-showInstances" type="checkbox" />
          </li>
          <li>
            <strong>Show Literals:</strong>
            <input id="val-showLiterals" type="checkbox" />
          </li>
          <li>
            <strong>Min Node Degree:</strong>
