---
// Any server-side logic can go here
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eristocracy - Three.js Fiddle</title>
    <style>
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto",
          sans-serif;
        background: #1a1a1a;
        color: #fff;
        height: 100vh;
        overflow: hidden;
      }

      .fiddle-container {
        display: grid;
        grid-template-rows: auto 1fr;
        height: 100vh;
        background: #1a1a1a;
        color: #ffffff;
        font-family: "JetBrains Mono", "Fira Code", monospace;
      }

      .toolbar {
        grid-column: 1 / -1;
        background: #2a2a2a;
        padding: 8px 16px;
        border-bottom: 1px solid #444;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .main-content {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        height: 100%;
        overflow: hidden;
      }

      .editor-section {
        display: flex;
        flex-direction: column;
        background: #1e1e1e;
        border-right: 1px solid #444;
        min-width: 400px;
      }

      .editor-header {
        background: #2a2a2a;
        padding: 8px 12px;
        border-bottom: 1px solid #444;
        font-size: 12px;
        color: #ccc;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .editor-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
      }

      #code-editor {
        flex: 1;
        font-family: "JetBrains Mono", "Fira Code", monospace;
        height: 100%;
        overflow: hidden;
        min-height: 0; /* Allow flex item to shrink below content size */
      }

      .resize-handle {
        width: 8px;
        background: #333;
        cursor: col-resize;
        position: relative;
        border-left: 1px solid #555;
        border-right: 1px solid #555;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
      }

      .resize-handle:hover {
        background: #0078d4;
      }

      .resize-handle::after {
        content: "⋮";
        color: #888;
        font-size: 16px;
        line-height: 1;
      }

      .canvas-section {
        display: flex;
        flex-direction: column;
        background: #0f0f0f;
        min-width: 400px;
      }

      .canvas-header {
        background: #2a2a2a;
        padding: 8px 12px;
        border-bottom: 1px solid #444;
        font-size: 12px;
        color: #ccc;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      #render-surface {
        flex: 1;
        overflow: hidden;
        position: relative;
        background: #0a0a0a;
      }

      .status {
        color: #888;
        font-size: 11px;
      }

      /* Button Styles */
      button {
        background: #0078d4;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.2s;
        font-size: 12px;
      }

      button:hover {
        background: #106ebe;
        transform: translateY(-1px);
      }

      /* CodeMirror theme adjustments */
      .cm-editor {
        height: 100% !important;
        background: #1e1e1e !important;
      }

      .cm-scroller {
        overflow: auto !important;
        height: 100% !important;
        font-family: "JetBrains Mono", "Fira Code", monospace !important;
      }

      /* Ensure scrollbars are visible */
      .cm-scroller::-webkit-scrollbar {
        width: 12px;
        height: 12px;
      }

      .cm-scroller::-webkit-scrollbar-track {
        background: #2a2a2a;
      }

      .cm-scroller::-webkit-scrollbar-thumb {
        background: #555;
        border-radius: 6px;
      }

      .cm-scroller::-webkit-scrollbar-thumb:hover {
        background: #666;
      }

      .cm-scroller::-webkit-scrollbar-corner {
        background: #2a2a2a;
      }

      /* Firefox scrollbar styling */
      .cm-scroller {
        scrollbar-width: thin;
        scrollbar-color: #555 #2a2a2a;
      }

      .cm-content {
        padding: 12px !important;
        min-height: 100% !important;
      }

      .cm-focused {
        outline: none !important;
      }

      .cm-line {
        padding: 0 4px !important;
        line-height: 1.4 !important;
      }
    </style>
  </head>
  <body>
    <div class="fiddle-container">
      <div class="toolbar">
        <button id="run-btn">▶ Run</button>
        <button id="clear-btn">Clear Output</button>
        <div class="status">
          Three.js Fiddle - Edit code on the left, see results on the right
        </div>
      </div>

      <div class="main-content">
        <div class="editor-section">
          <div class="editor-header">
            <div class="editor-info">
              <span style="color: #4ecdc4; font-weight: bold;"
                >JavaScript Editor</span
              >
              <span style="font-size: 10px; color: #888;">Three.js Fiddle</span>
            </div>
          </div>
          <div class="editor-container">
            <div id="code-editor"></div>
          </div>
        </div>

        <div class="resize-handle" id="resize-handle"></div>

        <div class="canvas-section">
          <div class="canvas-header">
            <span>Output Canvas</span>
          </div>
          <div id="render-surface"></div>
        </div>
      </div>
    </div>

    <script type="module">
      import { initializeFiddle } from "/src/lib/fiddle.js";

      // Initialize the fiddle when DOM is ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeFiddle);
      } else {
        initializeFiddle();
      }
    </script>
  </body>
</html>
