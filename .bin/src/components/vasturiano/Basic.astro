---
// src/components/ForceGraph3D.astro
---

<!-- 3D Graph Container (full viewport) -->
<div id="three-d-graph" class="graph-display"></div>

<!-- Floating Control Panel -->
<div id="control-panel" class="floating-panel">
  <div class="panel-header">
    <h3>Semantic Graph Controls</h3>
    <div class="panel-controls">
      <button id="minimize-btn" class="panel-btn">−</button>
      <button id="close-btn" class="panel-btn">×</button>
    </div>
  </div>

  <div class="panel-content">
    <!-- TTL File Selector -->
    <div class="control-group">
      <label for="ttl-select">Ontology File:</label>
      <select id="ttl-select" class="ttl-selector">
        <option value="">Loading ontologies...</option>
      </select>
    </div>

    <!-- Graph Information -->
    <div class="control-group">
      <div class="status-line">
        <span class="label">Status:</span>
        <span id="graph-status" class="status">Ready to load ontology</span>
      </div>
      <div class="status-line">
        <span class="label">Graph:</span>
        <span id="graph-metrics" class="metrics">0 nodes, 0 links</span>
      </div>
    </div>

    <!-- Performance Indicators -->
    <div class="control-group">
      <div class="status-line">
        <span class="label">Performance:</span>
        <span id="performance-metrics" class="performance">Ready</span>
      </div>
    </div>
  </div>
</div>

<script type="module">
  // Import the basic vasturiano graph initialization
  // The module will auto-initialize when loaded
  import "/src/lib/vasturiano/Basic.js";
</script>

<style>
  .graph-display {
    width: 100vw;
    height: 100vh;
    position: relative;
    background: #0a0a0a;
  }

  .floating-panel {
    position: fixed;
    top: 20px;
    left: 20px;
    width: 320px;
    background: rgba(15, 15, 15, 0.95);
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    z-index: 1000;
    cursor: move;
    transition: opacity 0.2s ease;
  }

  .floating-panel:hover {
    background: rgba(20, 20, 20, 0.98);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid #333;
    background: rgba(25, 25, 25, 0.8);
    border-radius: 8px 8px 0 0;
    cursor: grab;
  }

  .panel-header:active {
    cursor: grabbing;
  }

  .panel-header h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #0078d4;
  }

  .panel-controls {
    display: flex;
    gap: 4px;
  }

  .panel-btn {
    width: 24px;
    height: 24px;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
  }

  .panel-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .panel-content {
    padding: 16px;
  }

  .control-group {
    margin-bottom: 16px;
  }

  .control-group:last-child {
    margin-bottom: 0;
  }

  .control-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    color: #ccc;
  }

  .ttl-selector {
    width: 100%;
    padding: 8px 12px;
    background: rgba(30, 30, 30, 0.9);
    border: 1px solid #444;
    border-radius: 6px;
    color: #ffffff;
    font-size: 14px;
  }

  .ttl-selector:focus {
    outline: none;
    border-color: #0078d4;
    box-shadow: 0 0 0 2px rgba(0, 120, 212, 0.2);
  }

  .status-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .status-line:last-child {
    margin-bottom: 0;
  }

  .label {
    color: #888;
    font-weight: 500;
  }

  .status {
    color: #ccc;
    text-align: right;
    flex: 1;
    margin-left: 12px;
  }

  .metrics {
    color: #0078d4;
    font-weight: 500;
    text-align: right;
    flex: 1;
    margin-left: 12px;
  }

  .performance {
    color: #10b981;
    font-weight: 500;
    text-align: right;
    flex: 1;
    margin-left: 12px;
  }

  /* Minimized state */
  .floating-panel.minimized .panel-content {
    display: none;
  }

  .floating-panel.minimized {
    width: auto;
    min-width: 200px;
  }

  /* Hidden state */
  .floating-panel.hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>
